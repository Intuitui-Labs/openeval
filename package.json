{
  "name": "@intuitui-labs/openeval",
  "version": "0.1.0",
  "description": "Transparent, participatory evaluation, trade-off analysis, and recommendation framework for complex software ecosystems.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion.d.ts",
      "import": "./dist/ingestion.js",
      "default": "./dist/ingestion.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"fs.rmSync('node_modules',{recursive:true,force:true}); fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run check-types && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intuitui-labs/openeval.git"
  },
  "keywords": [
    "evaluation",
    "decision-framework",
    "scoring",
    "provenance",
    "recommendations",
    "orientation",
    "vitest5"
  ],
  "author": "Intuitui Labs & Neev Foundation",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
